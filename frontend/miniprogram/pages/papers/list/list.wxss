/*list.wxss*/
.container {
  flex: 1;
  padding: 20rpx;
  background-color: #f5f5f5;
}

.paper-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.paper-item {
  background-color: #fff;
  padding: 30rpx;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.paper-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
}

.paper-info {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 15rpx;
}

.paper-status {
  font-size: 24rpx;
  color: #1890ff;
  text-align: right;
}
