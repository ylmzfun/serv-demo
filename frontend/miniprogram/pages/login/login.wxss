/*login.wxss*/
.container {
  flex: 1;
  padding: 40rpx;
  background-color: #f5f5f5;
}

.login-form {
  background-color: #fff;
  padding: 40rpx;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.form-item {
  margin-bottom: 30rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
}

input {
  border: 1rpx solid #ddd;
  border-radius: 5rpx;
  padding: 20rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
}

.login-btn {
  width: 100%;
  height: 80rpx;
  background-color: #1890ff;
  color: #fff;
  font-size: 32rpx;
  border-radius: 5rpx;
  margin-top: 20rpx;
}

.register {
  text-align: center;
  margin-top: 30rpx;
  font-size: 24rpx;
  color: #666;
}

.register-link {
  color: #1890ff;
  margin-left: 10rpx;
}
