/*detail.wxss*/
.container {
  flex: 1;
  padding: 20rpx;
  background-color: #f5f5f5;
}

.exam-info {
  background-color: #fff;
  padding: 30rpx;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 30rpx;
}

.exam-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.exam-meta {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #666;
}

.start-btn {
  width: 100%;
  height: 80rpx;
  background-color: #1890ff;
  color: #fff;
  font-size: 32rpx;
  border-radius: 5rpx;
}
